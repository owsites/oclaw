# OpenWolf Podman environment
# Copy to openwolf.podman.env.local and set OPENWOLF_GATEWAY_TOKEN (or use -e when running).
# This file can be used with:
#   OPENWOLF_PODMAN_ENV=/path/to/openwolf.podman.env ./scripts/run-openwolf-podman.sh launch

# Required: gateway auth token. Generate with: openssl rand -hex 32
# Set this before running the container (or use run-openwolf-podman.sh which can generate it).
OPENWOLF_GATEWAY_TOKEN=

# Optional: web provider (leave empty to skip)
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# Host port mapping (defaults; override if needed)
OPENWOLF_PODMAN_GATEWAY_HOST_PORT=18789
OPENWOLF_PODMAN_BRIDGE_HOST_PORT=18790

# Gateway bind (used by the launch script)
OPENWOLF_GATEWAY_BIND=lan

# Optional: LLM provider API keys (for zero cost use Ollama locally or Groq free tier)
# OLLAMA_API_KEY=ollama-local
# GROQ_API_KEY=
